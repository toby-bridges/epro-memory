{
  "name": "@tobybridges/epro-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "ePro v2 — LLM-powered agent memory with 6-category classification and L0/L1/L2 tiered structure",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "clawdbot.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_LANCEDB_INTEGRATION=1 vitest run tests/db.integration.test.ts",
    "test:all": "vitest run && RUN_LANCEDB_INTEGRATION=1 vitest run tests/db.integration.test.ts"
  },
  "moltbot": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.23.0",
    "@sinclair/typebox": "0.34.47",
    "better-sqlite3": "^12.6.2",
    "openai": "^6.16.0",
    "sqlite-vec": "0.1.7-alpha.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
